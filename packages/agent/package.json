{
  "name": "dsh-limix-agent",
  "version": "0.3.12",
  "description": "展示预测、解释和模型比较的结果卡片与图表，提供“任务流程”页面和报告预览。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "assets/icon.png",
    "locale/*.json",
    "src",
    "tsdown.config.ts",
    "tsconfig.json",
    "LICENSE",
    "LICENSING.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.15.7",
    "typescript": "^5.9.3"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Limitless2023/limix-dsh.git",
    "directory": "packages/agent"
  },
  "homepage": "https://github.com/Limitless2023/limix-dsh#readme",
  "bugs": {
    "url": "https://github.com/Limitless2023/limix-dsh/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
