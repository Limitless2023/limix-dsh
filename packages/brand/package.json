{
  "name": "dsh-limix-cover",
  "version": "0.3.16",
  "description": "LimiX brand cover for the blank-session hero and the sidebar brand row.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/limix-icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/limix-icon.png",
    "assets/limix-mark.png",
    "src",
    "build.mjs",
    "README.md",
    "assets/limix-logo.png",
    "assets/SOURCES.md",
    "LICENSE",
    "LICENSING.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Limitless2023/limix-dsh.git",
    "directory": "packages/brand"
  },
  "homepage": "https://github.com/Limitless2023/limix-dsh#readme",
  "bugs": {
    "url": "https://github.com/Limitless2023/limix-dsh/issues"
  }
}
