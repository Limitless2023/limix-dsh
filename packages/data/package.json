{
  "name": "dsh-limix-data",
  "version": "0.3.8",
  "private": true,
  "type": "module",
  "description": "配置数据库连接，查看库表结构，执行只读查询并导出 CSV，供 LimiX 预测分析使用。",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.png"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/icon.png",
    "src",
    "tsdown.config.ts"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "mysql2": "^3.23.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "tsdown": "^0.15.7",
    "typescript": "^5.9.3"
  }
}
