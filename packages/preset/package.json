{
  "name": "dsh-limix-preset",
  "version": "0.3.10",
  "type": "module",
  "description": "组合 LimiX 工具与提示词，定义 Agent 工作方式，并设置新任务默认模式；保留用户已保存的默认选择。",
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "assets/icon.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.png",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Limitless2023/limix-dsh.git",
    "directory": "packages/preset"
  },
  "homepage": "https://github.com/Limitless2023/limix-dsh#readme",
  "bugs": {
    "url": "https://github.com/Limitless2023/limix-dsh/issues"
  }
}
