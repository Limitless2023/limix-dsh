{
  "name": "dsh-limix-preset",
  "version": "0.3.8",
  "private": true,
  "type": "module",
  "description": "组合 LimiX 工具与提示词，定义 Agent 工作方式，并设置新任务默认模式；保留用户已保存的默认选择。",
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "assets/icon.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.png",
    "./package.json": "./package.json"
  }
}
