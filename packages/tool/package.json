{
  "name": "dsh-limix-tool",
  "version": "0.3.12",
  "description": "在 LimiX Agent 模式中执行数据上传、预测、解释和模型比较，并保存结果文件。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "assets/limix*.py",
    "assets/icon.png",
    "locale/*.json",
    "src",
    "tsdown.config.ts",
    "LICENSE",
    "LICENSING.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.15.7",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Limitless2023/limix-dsh.git",
    "directory": "packages/tool"
  },
  "homepage": "https://github.com/Limitless2023/limix-dsh#readme",
  "bugs": {
    "url": "https://github.com/Limitless2023/limix-dsh/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
